<mxfile host="drawio" type="device"><diagram name="1 - Batch ingestion" id="1 - Batch ingestion"><mxGraphModel dx="2200" dy="1470" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1470" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;Diagram 1 · Batch data ingestion: data.gov.sg → HDB data lake (Amazon S3)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=22;align=left;verticalAlign=top;fontColor=#232F3E;fillColor=none;strokeColor=none;spacing=4;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1600" height="34" as="geometry"/></mxCell><mxCell id="c2" value="Network-segmented, serverless batch pipeline that runs the Part 1 ETL on AWS. Handles files &amp;gt;100 MB through streaming multipart upload and Spark-based processing." style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=top;fontColor=#5A6C86;fillColor=none;strokeColor=none;spacing=4;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1700" height="24" as="geometry"/></mxCell><mxCell id="inet" value="Internet (public)" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontStyle=1;rounded=1;arcSize=3;dashed=1;strokeColor=#7D8998;fillColor=none;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="250" height="560" as="geometry"/></mxCell><mxCell id="c3" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;fontSize=11;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.traditional_server;" vertex="1" parent="1"><mxGeometry x="119" y="230" width="48" height="48" as="geometry"/></mx