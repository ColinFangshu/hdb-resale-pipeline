8998;strokeWidth=1.5;dashed=1;dashPattern=2 3;exitX=0.2283;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="lake" target="c59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c91" value="8" style="ellipse;html=1;fillColor=#8C4FFF;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1256" y="1010" width="24" height="24" as="geometry"/></mxCell><mxCell id="c92" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;strokeColor=#7D8998;strokeWidth=1.5;dashed=1;dashPattern=2 3;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c29" target="c42"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1740" y="574"/><mxPoint x="1740" y="661"/></Array></mxGeometry></mxCell><mxCell id="c93" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;jumpStyle=arc;strokeColor=#7D8998;strokeWidth=1.5;dashed=1;dashPattern=2 3;" edge="1" parent="1" source="c42" target="c44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c94" value="9" style="ellipse;html=1;fillColor=#7D8998;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1858" y="638" width="24" height="24" as="geometry"/></mxCell><mxCell id="c95" value="Legend" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;rounded=1;arcSize=3;dashed=1;strokeColor=#7D8998;fillColor=none;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="740" width="260" height="300" as="geometry"/></mxCell><mxCell id="c96" value="" style="html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#ED7100;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="35" y="795" as="sourcePoint"/><mxPoint x="80" y="795" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c97" value="Data flow (file / table data)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;fillColor=none;strokeColor=none;spacing=4;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="90" y="783" width="185" height="32" as="geometry"/></mxCell><mxCell id="c98" value="" style="html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#DD344C;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="35" y="837" as="sourcePoint"/><mxPoint x="80" y="837" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c99" value="Internet-bound request&lt;br&gt;(inspected egress path)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;fillColor=none;strokeColor=none;spacing=4;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="90" y="825" width="185" height="32" as="geometry"/></mxCell><mxCell id="c100" value="" style="html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#E7157B;strokeWidth=2;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="35" y="879" as="sourcePoint"/><mxPoint x="80" y="879" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c101" value="Orchestration / control" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;fillColor=none;strokeColor=none;spacing=4;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="90" y="867" width="185" height="32" as="geometry"/></mxCell><mxCell id="c102" value="" style="html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#DD344C;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="35" y="921" as="sourcePoint"/><mxPoint x="80" y="921" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c103" value="Secret retrieval" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;fillColor=none;strokeColor=none;spacing=4;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="90" y="909" width="185" height="32" as="geometry"/></mxCell><mxCell id="c104" value="" style="html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#7D8998;strokeWidth=1.5;dashed=1;dashPattern=2 3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="35" y="963" as="sourcePoint"/><mxPoint x="80" y="963" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c105" value="Catalog / monitoring" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;fillColor=none;strokeColor=none;spacing=4;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="90" y="951" width="185" height="32" as="geometry"/></mxCell><mxCell id="c106" value="&lt;font color='#CD2264'&gt;■&lt;/font&gt; AWS account &amp;nbsp; &lt;font color='#8C4FFF'&gt;■&lt;/font&gt; VPC&lt;br&gt;&lt;font color='#00A4A6'&gt;■&lt;/font&gt; private subnet &amp;nbsp; &lt;font color='#7AA116'&gt;■&lt;/font&gt; public subnet" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;fillColor=none;strokeColor=none;spacing=4;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="990" width="245" height="40" as="geometry"/></mxCell><mxCell id="c107" value="Data flow, step by step" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=13;fontStyle=1;rounded=1;arcSize=3;dashed=1;strokeColor=#7D8998;fillColor=none;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="1275" width="2160" height="180" as="geometry"/></mxCell><mxCell id="c108" value="&lt;b&gt;1&lt;/b&gt; EventBridge Scheduler triggers the Step Functions workflow (daily; can be run on demand).&lt;br&gt;&lt;b&gt;2&lt;/b&gt; Step Functions runs the &lt;b&gt;ECS Fargate ingest task&lt;/b&gt; in a private subnet (Part 1 &lt;i&gt;extract.py&lt;/i&gt;).&lt;br&gt;&lt;b&gt;3&lt;/b&gt; The task calls the data.gov.sg metadata API. Traffic goes Transit Gateway → &lt;b&gt;Network Firewall (domain allow-list)&lt;/b&gt; → NAT → IGW. If &lt;i&gt;lastUpdatedAt&lt;/i&gt; is unchanged the run stops here, so reruns are idempotent.&lt;br&gt;&lt;b&gt;4&lt;/b&gt; For changed datasets the task initiates and polls the download. The file sits behind a &lt;b&gt;pre-signed, in-region S3 URL&lt;/b&gt;, so the GET goes through the &lt;b&gt;S3 gateway endpoint over the AWS backbone&lt;/b&gt;, never the internet. The endpoint policy allows only HDB buckets plus the data.gov.sg download bucket.&lt;br&gt;&lt;b&gt;5&lt;/b&gt; The file is &lt;b&gt;streamed to raw/ with S3 multipart upload&lt;/b&gt; (handles files &amp;gt;100 MB, objects up to 5 TB, with low memory use). Its SHA-256 is verified and the manifest updated. raw/ is protected by Object Lock." style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#232F3E;fillColor=none;strokeColor=none;spacing=4;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="1302" width="1070" height="185" as="geometry"/></mxCell><mxCell id="c109" value="&lt;b&gt;6&lt;/b&gt; Step Functions starts the &lt;b&gt;AWS Glue Spark jobs&lt;/b&gt; (Part 1 stages) running in the private subnets.&lt;br&gt;&lt;b&gt;7&lt;/b&gt; Glue reads raw/ and writes staging/, cleaned/, quarantined/, transformed/ and hashed/ as partitioned Parquet. It fetches the HMAC key from Secrets Manager through the interface endpoint.&lt;br&gt;&lt;b&gt;8&lt;/b&gt; Tables and partitions are registered in the &lt;b&gt;Glue Data Catalog&lt;/b&gt;. &lt;b&gt;Lake Formation&lt;/b&gt; controls access: hashed/ for Analytics, quarantined/ for data engineering only.&lt;br&gt;&lt;b&gt;9&lt;/b&gt; Logs and metrics go to CloudWatch. Alarms on job failure or quarantine rate &amp;gt;10% notify the on-call through SNS. Step Functions retries with backoff before alerting." style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#232F3E;fillColor=none;strokeColor=none;spacing=4;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1110" y="1302" width="1060" height="185" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>