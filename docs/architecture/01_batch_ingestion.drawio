" as="geometry"/></mxCell><mxCell id="c14" value="Network Firewall&lt;br&gt;endpoint" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=top;fontColor=#232F3E;fillColor=none;strokeColor=none;spacing=4;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="580.0" y="394" width="130" height="34" as="geometry"/></mxCell><mxCell id="c15" value="TGW subnet" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingLeft=30;spacingTop=2;fontSize=11;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#00A4A6;fillColor=#E6F6F7;fontColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="740" y="270" width="160" height="240" as="geometry"/></mxCell><mxCell id="c16" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;fontSize=11;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.transit_gateway_attachment;" vertex="1" parent="1"><mxGeometry x="796" y="344" width="48" height="48" as="geometry"/></mxCell><mxCell id="c17" value="Transit Gateway&lt;br&gt;attachment" style="text;html=1;whiteSpace=wrap;fontSize=11;align=center;verticalAlign=bottom;fontColor=#232F3E;fillColor=none;strokeColor=none;spacing=4;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="755.0" y="308" width="130" height="34" as="geometry"/></mxCell><mxCell id="c18" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.transit_gateway;" vertex="1" parent="1"><mxGeometry x="795" y="600" width="52" height="52" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&g